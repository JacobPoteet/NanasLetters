{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanas-letters",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nanas-letters-db",
      "database_id": "eb455876-47d8-41d6-bf7d-5cc77568cc36",
      "migrations_dir": "migrations"
    }
  ],
  // R2 enabled on the account and nanas-letters-photos created (see #4 —
  // deploy bootstrap checklist in CLAUDE.md).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nanas-letters-photos" }],
  "triggers": {
    // Once daily is enough for a habit that posts one letter each morning; see
    // CLAUDE.md's ingestion health monitoring note for what happens if a run
    // fails or finds nothing for several days running.
    "crons": ["17 13 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Secrets (set via `wrangler secret put`, never committed) — see .dev.vars.example:
  //   SESSION_SECRET, FAMILY_PASSPHRASE, ADMIN_PASSPHRASE
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
}
